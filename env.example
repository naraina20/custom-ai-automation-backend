# ==============================================================================
# Django Core Settings
# ==============================================================================
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*,localhost,127.0.0.1

# ==============================================================================
# Database Configuration
# ==============================================================================
# Use PostgreSQL (Supabase / Neon / AWS RDS) or leave blank for local SQLite:
# postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///db.sqlite3
DB_CONN_MAX_AGE=0

# ==============================================================================
# Cache & Channels (Optional - defaults to InMemoryChannelLayer if not set)
# ==============================================================================
REDIS_URL=redis://127.0.0.1:6379/0

# ==============================================================================
# Authentication (Clerk Gateway)
# ==============================================================================
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev

# ==============================================================================
# Brand & Email Configuration (HITL Alerts & Notifications)
# ==============================================================================
COMPANY_NAME=BodhixTech
COMPANY_SUPPORT_EMAIL=support@yourdomain.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=BodhixTech <support@yourdomain.com>

# ==============================================================================
# LLM Providers & Quota-Aware Failover Pools
# ==============================================================================
# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODELS_POOL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Groq API
GROQ_API_KEY=your-groq-api-key
GROQ_MODELS_POOL=openai/gpt-oss-20b,llama-3.1-8b-instant,qwen/qwen3.8-27b,openai/gpt-oss-120b

# Hugging Face Gravita Inference Model (Indian Tax & Default Builder)
HF_GRAVITA_ENDPOINT=https://hf.space
HF_TOKEN=

# ==============================================================================
# Google OAuth 2.0 Credentials (Workspace Integrations: Drive, Docs, Sheets, Gmail)
# ==============================================================================
# Authorized redirect URI in Google Console: http://localhost:3000/api/proxy/oauth/google/callback/
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/proxy/oauth/google/callback/
GOOGLE_DEVELOPER_KEY=your-google-developer-key

